    <bpmn:userTask id="Activity_1coqou1" name="Nephrologist cares for ptID with TM">
      <bpmn:documentation>if
:: alertStatus != confirmed -&gt;
  if
  :: ptStatus == stable || ptStatus == stable_C_addSvcs -&gt; ptStatus = recovered
  :: ptStatus == stable || ptStatus == stable_C_addSvcs -&gt; ptStatus = deceased
  :: else -&gt; skip
  fi
:: else -&gt; skip
fi</bpmn:documentation>
