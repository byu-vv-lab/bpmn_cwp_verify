    <bpmn:textAnnotation id="TextAnnotation_1q2yylp">
      <bpmn:text>Performers
- Provider
- BioMed scheduler
- TM_Monitor
- FloorStaff

Objects[properties]
EHR[has-- TM_Order[pt#; Rm#;status]
- TM_Units[#; status; location]
- Rm[#; dept]
- Patient[#; status; needs; ptRm]
- Alert[pt#; status]</bpmn:text>
