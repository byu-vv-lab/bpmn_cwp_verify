    <bpmn:task id="Activity_1nr3291" name="Box">
      <bpmn:documentation>(
    civic.frontTire.pressure,
    [civic.frontTire.pressure],
    if civic.frontTire.pressure &gt; 20
    then civic.frontTire.pressure - 5
    else civic.frontTire.pressure
),
(
    civic.passenger.isOpen,
    [civic.frontTire.pressure],
    if civic.frontTire.pressure &lt; 25
    then truthy
    else falsey
)</bpmn:documentation>
